{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "com.dejaydev.kirigo.gcal",
  "title": "gcal CLI output",
  "description": "Output schemas for the gcal (Google Calendar) CLI. Every command emits one JSON object; errors use the error envelope. Use --raw for the full Google event resource instead of the trimmed event shape below.",
  "oneOf": [
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/list" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/write" },
    { "$ref": "#/$defs/dryRun" },
    { "$ref": "#/$defs/freebusy" },
    { "$ref": "#/$defs/calendars" },
    { "$ref": "#/$defs/log" }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "required": ["status", "error"],
      "properties": {
        "status": { "const": "error" },
        "error": { "type": "string", "description": "Human-readable error message" }
      },
      "description": "Written to stderr. Exit code 2 for config/validation, 1 for runtime/API errors."
    },
    "event": {
      "type": "object",
      "required": ["id", "title", "start", "end", "all_day"],
      "description": "Trimmed event shape (default). Attendees are read-only; this CLI never sets them.",
      "properties": {
        "id": { "type": "string" },
        "calendar_id": { "type": "string" },
        "title": { "type": "string" },
        "start": { "type": "string", "description": "RFC3339 datetime, or YYYY-MM-DD when all_day" },
        "end": { "type": "string", "description": "RFC3339 datetime, or exclusive YYYY-MM-DD when all_day" },
        "all_day": { "type": "boolean" },
        "timezone": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "description": "Google event status: confirmed, tentative, cancelled" },
        "html_link": { "type": "string" },
        "recurrence": { "type": "array", "items": { "type": "string" }, "description": "RRULE/EXDATE lines on a recurring master" },
        "recurring_event_id": { "type": "string", "description": "Master id when this is an expanded instance" },
        "attendees": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "email": { "type": "string" },
              "display_name": { "type": "string" },
              "response_status": { "type": "string" },
              "optional": { "type": "boolean" },
              "organizer": { "type": "boolean" }
            }
          }
        },
        "organizer": { "type": "string" },
        "updated": { "type": "string", "format": "date-time" }
      }
    },
    "list": {
      "type": "object",
      "required": ["status", "from", "to", "events"],
      "description": "gcal list — time-ordered, expanded event instances across the queried calendars.",
      "properties": {
        "status": { "const": "ok" },
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
      }
    },
    "write": {
      "type": "object",
      "required": ["status", "op_id", "event"],
      "description": "create/update/delete/quickadd/restore success. op_id addresses the snapshot for `gcal restore`.",
      "properties": {
        "status": { "const": "ok" },
        "op": { "type": "string", "description": "Present for restore" },
        "op_id": { "type": "string" },
        "restored_op": { "type": "string", "description": "The op id that restore reversed" },
        "event": { "description": "Trimmed event, or the full Google resource with --raw. For a delete, the event that was removed." },
        "backup_error": { "type": "string", "description": "Set if the mutation succeeded but the snapshot could not be written (not restorable)" }
      }
    },
    "dryRun": {
      "type": "object",
      "required": ["status", "op", "calendar"],
      "description": "Any mutation with --dry-run. Nothing is written and no snapshot is recorded.",
      "properties": {
        "status": { "const": "dry-run" },
        "op": { "type": "string", "enum": ["create", "update", "delete", "quickadd", "restore"] },
        "calendar": { "type": "string" },
        "before": { "description": "Event state before the change, or null" },
        "after": { "description": "Event state after the change, or null (delete)" },
        "patch": { "description": "For update: the fields that would change" },
        "text": { "type": "string", "description": "For quickadd" }
      }
    },
    "freebusy": {
      "type": "object",
      "required": ["status", "from", "to", "calendars"],
      "description": "gcal freebusy — busy intervals per calendar plus merged free windows in the range. free is present only when every calendar was read; otherwise free_error explains the omission.",
      "properties": {
        "status": { "const": "ok" },
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "calendars": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "busy"],
            "properties": {
              "id": { "type": "string" },
              "busy": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": { "type": "string", "format": "date-time" },
                    "end": { "type": "string", "format": "date-time" }
                  }
                }
              },
              "errors": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Google reasons (e.g. notFound) when this calendar's free/busy could not be read"
              }
            }
          }
        },
        "free": {
          "type": "array",
          "description": "Open windows across all queried calendars, within [from,to). Omitted if any calendar reported errors.",
          "items": {
            "type": "object",
            "properties": {
              "start": { "type": "string", "format": "date-time" },
              "end": { "type": "string", "format": "date-time" }
            }
          }
        },
        "free_error": { "type": "string", "description": "Set when free is omitted because a calendar could not be read" }
      }
    },
    "calendars": {
      "type": "object",
      "required": ["status", "calendars"],
      "description": "gcal calendars — the calendars this account can access.",
      "properties": {
        "status": { "const": "ok" },
        "calendars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "summary": { "type": "string" },
              "timezone": { "type": "string" },
              "access_role": { "type": "string", "enum": ["owner", "writer", "reader", "freeBusyReader"] },
              "primary": { "type": "boolean" }
            }
          }
        }
      }
    },
    "log": {
      "type": "object",
      "required": ["status", "ops"],
      "description": "gcal log — past mutations newest-first. Also the shape returned by prune (as {status, pruned}).",
      "properties": {
        "status": { "const": "ok" },
        "pruned": { "type": "integer", "description": "gcal prune: number of snapshots removed" },
        "ops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["op_id", "time", "verb", "calendar"],
            "properties": {
              "op_id": { "type": "string" },
              "time": { "type": "string", "format": "date-time" },
              "verb": { "type": "string", "enum": ["create", "update", "delete", "quickadd", "restore"] },
              "calendar": { "type": "string" },
              "event_id": { "type": "string" },
              "summary": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
